{
  "schema_version": "v1",
  "framework": "nitro",
  "type": "server",
  "build_system": "nixpacks",
  "deployment_target": "docker",
  "runtime": "bun",
  "version": ">=1.1.0",
  "port": 3000,

  "build": "bun run build",
  "start": "bun run preview",

  "build_meta": {
    "pm": "bun",
    "build_script": "build",
    "start_script": "preview",
    "entry": ".output/server/index.mjs",
    "output_dir": ".output",
    "notes": "Nitro output is .output; start via preview script or node .output/server/index.mjs"
  }
}
